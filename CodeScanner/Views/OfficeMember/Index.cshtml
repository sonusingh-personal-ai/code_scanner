@model Entity.enOfficeMember
@{
    var OfficeMembers = new List<Entity.enOfficeMember>();
    OfficeMembers = ViewBag.OfficeMemberList;
    var sn = 1;
}

<script>
    function triggerMe() {
        return false;
    }
</script>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-4">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Add Model</h3>
                    </div>
                    @using (Html.BeginForm())
                    {
                        <div class="card-body">
                            <div class="form-group">
                                <label for="exampleInputEmail1">Name</label>
                                @Html.DropDownListFor(model => model.Type, new List<SelectListItem> { new SelectListItem { Text = "Visual By", Value = "1" }, new SelectListItem { Text = "Tested By", Value = "2" }, new SelectListItem { Text = "Process engg.", Value = "3" }, new SelectListItem { Text = "Display Prog No.", Value = "4" } }, "Select Member", new { @class = "form-control" })
                            </div>
                            <div class="form-group">
                                <label for="exampleInputPassword1">Value</label>
                                @Html.TextBoxFor(m => m.Name, new { type = "text", required = "required", @class = "form-control", placeholder = "Enter Value" })
                            </div>
                        </div>
                        <div class="card-footer">
                            <input type="submit" value="Submit" class="btn btn-primary" />
                        </div>
                    }
                </div>
                <!-- /.card -->
            </div>
            @if (OfficeMembers != null)
            {
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Model Table</h3>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width: 10px">#</th>
                                        <th>Name</th>
                                        <th>Value</th>
                                        <th style="width: 100px">Edit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in OfficeMembers)
                                        {
                                        var type = Utility.Helper.officeMemberName(item.Type);
                                            <tr>
                                                <td>@sn</td>
                                                <td>@type</td>
                                                <td>
                                                    @item.Name
                                                </td>
                                                <td><a href="/officeMember/update/@item.ID"><i class="fas fa-edit"></i></a> || <a href="/officeMember/delete/@item.ID" onclick="javascript:triggerMe()" ><i class="fas fa-trash-alt"></i> </a></td>
                                            </tr>
                                            sn++;
                                        }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>