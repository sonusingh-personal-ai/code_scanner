@model Entity.enModel
@{
    var ModelList = new List<Entity.enModel>();
    if (Model == null)
    {
        ModelList = ViewBag.ModelList;
    }
    var sn = 1;
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Add Path</h3>
                    </div>

                    <div class="card-body">
                        <div class="form-group">
                            <label for="exampleInputEmail1">Qr Code Path</label>
                            <input id="qrCodePath" type="text" required="required" class="form-control" placeholder="Qr Code Path" value="@ViewBag.QrCodePath" />
                        </div>
                        <div class="form-group">
                            <label for="exampleInputPassword1">Excel Path</label>
                            <input id="excelPath" type="text" required="required" class="form-control" placeholder="Excel Path"  value="@ViewBag.Excelpath"/>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button onclick="savePath()" value="Submit" class="btn btn-primary" >Submit</button>
                    </div>
                </div>
                <!-- /.card -->
            </div>
            <div class="col-md-3">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Add Model</h3>
                    </div>
                    @using (Html.BeginForm())
                    {
                        <div class="card-body">
                            <div class="form-group">
                                <label for="exampleInputEmail1">Name</label>
                                @Html.TextBoxFor(m => m.Name, new { type = "text", required = "required", @class = "form-control", placeholder = "Enter Name" })
                            </div>
                            <div class="form-group">
                                <label for="exampleInputPassword1">Value</label>
                                @Html.TextBoxFor(m => m.Value, new { type = "text", required = "required", @class = "form-control", placeholder = "Enter Value" })
                            </div>
                        </div>
                        <div class="card-footer">
                            <input type="submit" value="Submit" class="btn btn-primary" />
                        </div>
                    }
                </div>
                <!-- /.card -->
            </div>
            @if (Model == null)
            {
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Model Table</h3>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width: 10px">#</th>
                                        <th>Name</th>
                                        <th>Value</th>
                                        <th style="width: 40px">Edit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in ModelList)
                                    {
                                    <tr>
                                        <td>@sn</td>
                                        <td>@item.Name</td>
                                        <td>
                                            @item.Value
                                        </td>
                                        <td><a href="/model/update/@item.Id">Edit</a></td>
                                    </tr>
                                        sn++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>