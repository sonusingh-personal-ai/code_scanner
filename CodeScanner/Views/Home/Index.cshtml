@{
    ViewBag.Title = "Index";
    var QrCode = "";
    var PrinterName = "";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    * {
        box-sizing: border-box;
    }

    .row {
        margin-left: -5px;
        margin-right: -5px;
    }

    .form-control {
        margin-bottom: 0rem !important;
    }

    label {
        display: inline;
    }

    label:not(.form-check-label):not(.custom-file-label) {
        font-weight: 300;
    }

    .form-group {
        margin-bottom: 0rem;
    }

    .content-header {
        padding: 1px .5rem;
    }

    .table td, .table th {
        padding: 0em !important;
        font-weight: 100;
    }

    td, th {
        text-align: center;
        vertical-align: middle;
    }

    .isValidate,
    .select2-container .select2-selection--single.isValidate,
    .select2-container.isValidate .select2-selection--single {
        border-color: red !important;
    }
/* 1. Fix Select2 container height and vertical alignment */
.select2-container--default .select2-selection--single {
    height: 38px !important;
    display: flex !important;
    align-items: center !important;
    border-color: #ced4da;
}

/* 2. Left-align text for both rendered value & placeholder */
.select2-container--default .select2-selection--single .select2-selection__rendered,
.select2-container--default .select2-selection--single .select2-selection__placeholder {
    color: #495057 !important; /* Standard input text color */
    text-align: left !important; /* Left alignment */
    width: 100% !important;
    line-height: 38px !important; /* Vertical centering */
    padding-left: 2px !important; /* Left padding matching standard controls */
    padding-right: 25px !important; /* Right padding to clear arrow icon */
}

/* 3. Center the dropdown arrow vertically */
.select2-container--default .select2-selection--single .select2-selection__arrow {
    height: 38px !important;
    top: 0 !important;
    right: 5px !important;
}

/* 4. Hide clear (cross) button */
.select2-container--default .select2-selection--single .select2-selection__clear,
.select2-selection__clear {
    display: none !important;
}
</style>

<script src="~/Content/scripts/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    $(document).ready(function(){
        $(".main-header").hide();

        var port = @Html.Raw(Json.Encode(ViewBag.gen));
        var printerList = @Html.Raw(Json.Encode(ViewBag.Printers));
        var visualByList = @Html.Raw(Json.Encode(ViewBag.VisualBy));
        var testedByList = @Html.Raw(Json.Encode(ViewBag.TestedBy));
        var processEngList = @Html.Raw(Json.Encode(ViewBag.ProcessEng));
        var progDisplayNo = @Html.Raw(Json.Encode(ViewBag.ProgramDisplayNumber));
        var printerModelList = @Html.Raw(Json.Encode(ViewBag.PrinterModelList));

        // 1. Initialize Line Select2 & Load Data
        initLineSelect2();
        loadLines();

        // 2. Attach Event Handlers for Line Dropdown
        bindLineEvents();

        // Populate dropdowns
        $("#com_port").empty();
        $.each(port, function(indx, val){
            $("#com_port").append("<option value='"+val.Key +"'>"+val.Value+"</option>");
        });

        $("#prnter").empty();
        $.each(printerList, function(indx, val){
            $("#prnter").append("<option value='"+val.Key +"'>"+val.Value+"</option>");
        });

        $("#visualBy").append("<option value=''>Select Visual By</option>");
        $("#testedBy").append("<option value=''>Select Tested By</option>");
        $("#processEngg").append("<option value=''>Select ProcEng.</option>");

        $.each(visualByList, function(indx, val){
            $("#visualBy").append("<option value='"+val.ID +"'>"+val.Name+"</option>");
        });
        $.each(testedByList, function(indx, val){
            $("#testedBy").append("<option value='"+val.ID +"'>"+val.Name+"</option>");
        });
        $.each(processEngList, function(indx, val){
            $("#processEngg").append("<option value='"+val.ID +"'>"+val.Name+"</option>");
        });
        $.each(progDisplayNo, function(indx, val){
            $("#display_pv").append("<option value='"+val.ID +"'>"+val.Name+"</option>");
        });

        $.each(printerModelList, function (indx, val) {
            $("#printerModel").append("<option value='" + val.Id + "'>" + val.Name + "</option>");
        });

        $("#printerModel").on("change", function () {
            var val = $(this).val();
            if (val && val !== "" && val !== "0") {
                localStorage.setItem("printerModel", val);
                $(this).removeClass("isValidate").addClass("validate");
            }
        });

        if (port.length > 0) {
            $("#info_status").val("Enable").css("background", "green");
        } else {
            $("#info_status").val("Disable").css("background", "red");
        }

        setInfo();
        validateFileds();

        var assemblyFirstScanDone = false;

        $('#bCode').codeScanner({
            maxEntryTime: 500,
            onScan: function ($element, code) {
                $('#sysNumber').val('');
                $('#sysNumber').val(code);

                var productionLine = $("#productionLine").val();

                if (productionLine == '2') {
                    if (!assemblyFirstScanDone) {
                        assemblyFirstScanDone = true;
                        $("#serialCardNo").val(code);
                        $("#serialCardNo").focus();

                        $("#serialCardNo").css("border-color", "green");
                        setTimeout(function() {
                            $("#serialCardNo").css("border-color", "");
                        }, 500);

                        return;
                    } else {
                        assemblyFirstScanDone = false;

                        if (!validateProductionLine()) {
                            alert("If production line is assembly, card serial number must have a valid number.");
                            return;
                        }

                        SendToComPort(false);
                    }
                } else {
                    assemblyFirstScanDone = false;

                    if (!validateProductionLine()) {
                        alert("If production line is assembly, card serial number must have a valid number.");
                        return;
                    }

                    SendToComPort(false);
                }
            }
        });

        getValueFromLocalStorage();

        $("#productionLine").on("change", function(i, e){
            checkProductionLine();
            assemblyFirstScanDone = false;
        });

        $('#productionLine').trigger("change");

        collaps();
        setCustomSwtich();
    });

    function checkProductionLine() {
        $("#serialCardNo").val('');
        var ProdLine = $("#productionLine").val();
        if (ProdLine == '1') {
            var currentSerialCardNo = $("#serialCardNo").val();
            if (currentSerialCardNo && currentSerialCardNo.trim() !== '') {
                localStorage.setItem("serialCardNo", currentSerialCardNo);
            }
            $("#serialCardNo").attr("disabled", "disabled").val('');
        } else if (ProdLine == '2') {
            $("#serialCardNo").removeAttr("disabled");
            setTimeout(function() {
                $("#serialCardNo").focus();
            }, 100);
        }
    }

    function validate() {
        $("QcStatus").val();
    }

    // ==========================================
    // SELECT2 LINE DROPDOWN IMPLEMENTATION
    // ==========================================

    function initLineSelect2() {
        $('#ddlLine').select2({
            placeholder: "-- Select Line --",
            allowClear: false,
            templateResult: formatLineOption
        });
    }

    function formatLineOption(state) {
        if (!state.id) return state.text;

        if (state.id === '__ADD_NEW__') {
            return $('<span class="text-primary font-weight-bold"><i class="fa fa-plus-circle"></i> ' + state.text + '</span>');
        }

        var item = $(state.element).data('lineItem') || {};
        var seq = item.Sequence || '';
        var seqBadge = seq ? '<span class="badge badge-light border text-dark mr-2" style="font-size:0.75rem; min-width:20px; text-align:center;">' + seq + '</span>' : '';

        var $option = $(
            '<div class="d-flex justify-content-between align-items-center line-item-row" data-id="' + state.id + '" data-name="' + state.text + '" data-sequence="' + seq + '">' +
                '<span>' + seqBadge + state.text + '</span>' +
                '<span class="action-buttons">' +
                    '<i class="fa fa-arrow-up text-secondary mr-1 btn-move-up-line" title="Move Up" style="cursor:pointer; padding:2px;"></i>' +
                    '<i class="fa fa-arrow-down text-secondary mr-2 btn-move-down-line" title="Move Down" style="cursor:pointer; padding:2px;"></i>' +
                    '<i class="fa fa-edit text-info mr-2 btn-edit-line" title="Edit Line" style="cursor:pointer; padding:2px;"></i>' +
                    '<i class="fa fa-trash text-danger btn-delete-line" title="Delete Line" style="cursor:pointer; padding:2px;"></i>' +
                '</span>' +
            '</div>'
        );

        return $option;
    }

    function renderSelect2Options(lines, selectedId) {
        var ddl = $('#ddlLine');
        ddl.empty();
        ddl.append(new Option('-- Select Line --', '', false, false));

        if (lines && lines.length > 0) {
            $.each(lines, function (i, item) {
                var optionName = item.Name || item.Text || item;
                var optionId = item.Id || item.Value || item;
                
                var newOption = new Option(optionName, optionId, false, false);
                $(newOption).data('lineItem', item);
                ddl.append(newOption);
            });
        }

        var addOption = new Option('+ Add New Line', '__ADD_NEW__', false, false);
        ddl.append(addOption);

        if (selectedId) {
            ddl.val(selectedId).trigger('change');
        } else {
            ddl.val('').trigger('change');
        }
    }

    function loadLines(selectedId) {
        var lineToSelect = selectedId || localStorage.getItem("selectedLine");
        $.ajax({
            url: '/Home/GetLines',
            type: 'GET',
            success: function (data) {
                renderSelect2Options(data, lineToSelect);
            },
            error: function () {
                alert('Failed to load lines.');
            }
        });
    }

    function addNewLine() {
        $('#ddlLine').val('').trigger('change');

        var lineName = prompt("Enter new Line Name:");
        if (lineName && lineName.trim() !== "") {
            var seqStr = prompt("Enter Sequence / Order (optional, leave blank for auto):", "");
            var seq = parseInt(seqStr, 10);
            var postData = { name: lineName.trim() };
            if (!isNaN(seq) && seq > 0) {
                postData.sequence = seq;
            }

            $.ajax({
                url: '/Home/AddLine',
                type: 'POST',
                data: postData,
                success: function (res) {
                    if (res.success) {
                        loadLines();
                    } else {
                        alert("Failed to add line.");
                    }
                }
            });
        }
    }

    function editLine(id, currentName, currentSequence) {
        $('#ddlLine').select2('close');

        var newName = prompt("Update Line Name:", currentName);
        if (!newName || newName.trim() === "") return;

        var seqPrompt = currentSequence ? currentSequence : "1";
        var seqStr = prompt("Update Sequence / Order:", seqPrompt);
        var seq = parseInt(seqStr, 10);
        var postData = { id: id, name: newName.trim() };
        if (!isNaN(seq) && seq > 0) {
            postData.sequence = seq;
        }

        $.ajax({
            url: '/Home/UpdateLine',
            type: 'POST',
            data: postData,
            success: function (res) {
                if (res.success) {
                    loadLines(id);
                } else {
                    alert("Failed to update line.");
                }
            }
        });
    }

    function moveLine(id, direction) {
        $.ajax({
            url: '/Home/MoveLine',
            type: 'POST',
            data: { id: id, direction: direction },
            success: function (res) {
                if (res.success) {
                    var currentVal = $('#ddlLine').val();
                    loadLines(currentVal);
                } else {
                    alert("Failed to move line.");
                }
            }
        });
    }

    function deleteLine(id, currentName) {
        $('#ddlLine').select2('close');

        if (confirm('Are you sure you want to delete "' + currentName + '"?')) {
            $.ajax({
                url: '/Home/DeleteLine',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        localStorage.removeItem("selectedLine");
                        loadLines();
                    } else {
                        alert("Failed to delete line.");
                    }
                }
            });
        }
    }

    function bindLineEvents() {
        $('#ddlLine').on('select2:select change', function (e) {
            var selectedVal = $('#ddlLine').val();
            if (selectedVal === '__ADD_NEW__') {
                addNewLine();
            } else if (selectedVal && selectedVal !== "" && selectedVal !== "0") {
                localStorage.setItem("selectedLine", selectedVal);
                $('#ddlLine').removeClass('isValidate').addClass('validate');
                $('#ddlLine').next('.select2-container').find('.select2-selection').removeClass('isValidate');
            }
        });

        $(document).on('mouseup touchend click', '.btn-move-up-line', function (e) {
            e.preventDefault();
            e.stopPropagation();

            var parentRow = $(this).closest('.line-item-row');
            var id = parentRow.data('id');
            moveLine(id, 'up');
        });

        $(document).on('mouseup touchend click', '.btn-move-down-line', function (e) {
            e.preventDefault();
            e.stopPropagation();

            var parentRow = $(this).closest('.line-item-row');
            var id = parentRow.data('id');
            moveLine(id, 'down');
        });

        $(document).on('mouseup touchend click', '.btn-edit-line', function (e) {
            e.preventDefault();
            e.stopPropagation();

            var parentRow = $(this).closest('.line-item-row');
            var id = parentRow.data('id');
            var currentName = parentRow.data('name');
            var currentSequence = parentRow.data('sequence');

            editLine(id, currentName, currentSequence);
        });

        $(document).on('mouseup touchend click', '.btn-delete-line', function (e) {
            e.preventDefault();
            e.stopPropagation();

            var parentRow = $(this).closest('.line-item-row');
            var id = parentRow.data('id');
            var currentName = parentRow.data('name');

            deleteLine(id, currentName);
        });
    }
</script>

