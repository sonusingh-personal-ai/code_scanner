<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-striped" id="export_table_0">
                    <thead>
                        <tr>
                            <th style="width: 10px">Sn.</th>
                            <th>Parameters</th>
                            <th>Display</th>
                            <th>Actual</th>
                            <th style="vertical-align: middle; height: 38px;">status</th>
                        </tr>
                    </thead>
                    <tbody id="testResponse_0"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th style="width: 10px">Sn.</th>
                            <th>Parameters</th>
                            <th>Display</th>
                            <th>Actual</th>
                            <th style="vertical-align: middle; height: 38px;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>status</span>
                                    <button type="button" id="btnToggleTelemetry" class="btn btn-xs btn-outline-info" style="font-size: 11px; padding: 2px 8px; font-weight: 600; line-height: 1.2;" title="Hide / Unhide Info & Telemetry Panel">
                                        <i class="fas fa-eye-slash mr-1" id="iconToggleTelemetry"></i><span id="textToggleTelemetry">Hide Info</span>
                                    </button>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="testResponse_1"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Live Test Data Analysis & Telemetry Panel -->
<div class="row mt-2" id="telemetrySection">
    <div class="col-12">
        <div class="card card-primary card-outline card-outline-tabs shadow-sm mb-3">
            <div class="card-header p-0 border-bottom-0">
                <ul class="nav nav-tabs" id="telemetryTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="tab-cycle-breakdown" data-toggle="pill" href="#content-cycle-breakdown" role="tab">
                            <i class="fas fa-layer-group text-primary mr-1"></i> Cycle-by-Cycle Breakdown
                            <span class="badge badge-info ml-1" id="badgeCycleCount">0 Cycles</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-raw-stream" data-toggle="pill" href="#content-raw-stream" role="tab">
                            <i class="fas fa-terminal text-success mr-1"></i> Raw Serial Stream Console
                            <span class="badge badge-secondary ml-1" id="badgeStreamPackets">0 Packets</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-shift-kpi" data-toggle="pill" href="#content-shift-kpi" role="tab">
                            <i class="fas fa-chart-line text-warning mr-1"></i> Shift Quality & KPIs
                        </a>
                    </li>
                    <li class="nav-item ml-auto pr-2 py-1 d-flex align-items-center">
                        <span id="testRunStatusIndicator" class="badge badge-secondary mr-2 py-1 px-2" style="font-size: 0.85rem;">Standby</span>
                        <button type="button" class="btn btn-sm btn-success mr-2" id="btnExportTestCSV" title="Export and view test data in JSON format" disabled>
                            <i class="fas fa-file-code mr-1"></i> Export (JSON)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClearTelemetry" title="Clear recorded cycle history">
                            <i class="fas fa-trash-alt mr-1"></i> Clear
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary ml-1" id="btnCloseTelemetryPanel" title="Hide Info & Telemetry Panel">
                            <i class="fas fa-times"></i>
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-2">
                <div class="tab-content" id="telemetryTabContent">
                    <!-- Tab 1: Cycle-by-Cycle Parameter Breakdown -->
                    <div class="tab-pane fade show active" id="content-cycle-breakdown" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <div class="small text-muted" id="cycleSummaryText">
                                <i class="fas fa-info-circle mr-1"></i> No test run recorded yet. Scan or enter a barcode to begin logging cycles.
                            </div>
                            <div class="d-flex align-items-center">
                                <label class="small text-muted mr-2 mb-0">Filter Cycle:</label>
                                <select id="ddlCycleSelector" class="form-control form-control-sm" style="width: 180px;">
                                    <option value="ALL">All Cycles (Timeline)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Cycle container (scrollable list) -->
                        <div id="cycleHistoryList" style="max-height: 380px; overflow-y: auto; padding-right: 4px;">
                            <div class="text-center py-4 text-muted" id="emptyCyclePlaceholder">
                                <i class="fas fa-stream fa-2x mb-2 text-secondary"></i>
                                <p class="mb-0 font-weight-bold">Waiting for device test sequence to start...</p>
                                <small>Each telemetry frame received from start to PASS/FAIL will be recorded here for inspection.</small>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: Raw Serial Stream Console -->
                    <div class="tab-pane fade" id="content-raw-stream" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-1 px-1">
                            <div class="small text-muted">
                                <i class="fas fa-microchip mr-1"></i> Live incoming RS-232 / simulator frames (<span id="streamActivePort">Disconnected</span>)
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="custom-control custom-checkbox mr-3">
                                    <input type="checkbox" class="custom-control-input" id="chkAutoScroll" checked>
                                    <label class="custom-control-label small" for="chkAutoScroll">Auto-scroll</label>
                                </div>
                                <button type="button" class="btn btn-xs btn-outline-secondary" id="btnCopyRawConsole" title="Copy console to clipboard">
                                    <i class="fas fa-copy mr-1"></i> Copy
                                </button>
                            </div>
                        </div>
                        <div id="rawStreamConsole" style="background-color: #1e1e2f; color: #a6e22e; font-family: 'Consolas', 'Courier New', monospace; font-size: 12px; height: 320px; overflow-y: auto; padding: 10px; border-radius: 4px; border: 1px solid #333; line-height: 1.5; white-space: pre-wrap;">
[SYSTEM] Ready. Diagnostic serial stream listener initialized.
                        </div>
                    </div>

                    <!-- Tab 3: Shift Productivity & KPIs -->
                    <div class="tab-pane fade" id="content-shift-kpi" role="tabpanel">
                        <div class="row pt-2 pb-1">
                            <!-- Card 1: Shift Total -->
                            <div class="col-lg-3 col-6">
                                <div class="info-box bg-light shadow-sm border">
                                    <span class="info-box-icon bg-info elevation-1"><i class="fas fa-cubes"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text text-muted text-uppercase" style="font-size: 0.75rem; font-weight: 600;">Shift Total Tested</span>
                                        <span class="info-box-number" id="kpiShiftTotal" style="font-size: 1.6rem; font-weight: 700;">0</span>
                                        <div class="progress progress-xs mt-1"><div class="progress-bar bg-info" style="width: 100%"></div></div>
                                        <span class="progress-description text-muted small mt-1">Total units processed today</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 2: Passed Units -->
                            <div class="col-lg-3 col-6">
                                <div class="info-box bg-light shadow-sm border">
                                    <span class="info-box-icon bg-success elevation-1"><i class="fas fa-check-circle"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text text-muted text-uppercase" style="font-size: 0.75rem; font-weight: 600;">Passed Units</span>
                                        <span class="info-box-number text-success" id="kpiPassedUnits" style="font-size: 1.6rem; font-weight: 700;">0</span>
                                        <div class="progress progress-xs mt-1"><div class="progress-bar bg-success" style="width: 100%"></div></div>
                                        <span class="progress-description text-muted small mt-1">Passed inspection / QC</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 3: Failed Units -->
                            <div class="col-lg-3 col-6">
                                <div class="info-box bg-light shadow-sm border">
                                    <span class="info-box-icon bg-danger elevation-1"><i class="fas fa-times-circle"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text text-muted text-uppercase" style="font-size: 0.75rem; font-weight: 600;">Failed Units</span>
                                        <span class="info-box-number text-danger" id="kpiFailedUnits" style="font-size: 1.6rem; font-weight: 700;">0</span>
                                        <div class="progress progress-xs mt-1"><div class="progress-bar bg-danger" style="width: 100%"></div></div>
                                        <span class="progress-description text-muted small mt-1">Defective / out of tolerance</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 4: First Pass Yield -->
                            <div class="col-lg-3 col-6">
                                <div class="info-box bg-light shadow-sm border">
                                    <span class="info-box-icon bg-warning elevation-1"><i class="fas fa-chart-pie text-white"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text text-muted text-uppercase" style="font-size: 0.75rem; font-weight: 600;">First Pass Yield</span>
                                        <span class="info-box-number" id="kpiYieldRate" style="font-size: 1.6rem; font-weight: 700;">100%</span>
                                        <div class="progress progress-xs mt-1">
                                            <div class="progress-bar bg-success" id="kpiYieldBar" style="width: 100%"></div>
                                        </div>
                                        <span class="progress-description text-muted small mt-1">Target quality threshold &ge; 95%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Export Test Telemetry in JSON Format -->
<div class="modal fade" id="modalExportJson" tabindex="-1" role="dialog" aria-labelledby="modalExportJsonLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h5 class="modal-title font-weight-bold" id="modalExportJsonLabel" style="font-size: 1.05rem;">
                    <i class="fas fa-file-code mr-2"></i>Test Telemetry Export (JSON Format)
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="opacity: 0.9;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-3" style="background-color: #f8f9fa;">
                <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                    <span class="text-muted small" id="jsonExportMeta">Metadata</span>
                    <div>
                        <button type="button" class="btn btn-xs btn-outline-secondary" id="btnToggleWrapJson" title="Toggle word wrap">
                            <i class="fas fa-align-left mr-1"></i> Toggle Wrap
                        </button>
                    </div>
                </div>
                <pre id="jsonExportContent" class="p-3 bg-dark text-light rounded border mb-0" style="max-height: 480px; overflow: auto; font-family: 'Consolas', 'Courier New', monospace; font-size: 12px; line-height: 1.4; user-select: text; white-space: pre;"></pre>
            </div>
            <div class="modal-footer py-2 d-flex justify-content-between">
                <div>
                    <button type="button" class="btn btn-sm btn-outline-success" id="btnDownloadCsvFromModal" title="Also download as CSV spreadsheet">
                        <i class="fas fa-file-excel mr-1"></i> Download CSV
                    </button>
                </div>
                <div>
                    <button type="button" class="btn btn-sm btn-outline-info mr-2" id="btnCopyJson">
                        <i class="fas fa-copy mr-1"></i> <span id="btnCopyJsonText">Copy JSON</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-primary mr-2" id="btnDownloadJson">
                        <i class="fas fa-download mr-1"></i> Download .JSON
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
