@{
    ViewBag.Title = "Setting";
}
@*<script src="https://code.jquery.com/jquery-3.5.1.min.js"
        integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
        crossorigin="anonymous"></script>*@
<script src="~/Content/scripts/jquery-3.5.1.min.js"></script>
<script>
    $(document).ready(function(){
        var modelList = @Html.Raw(Json.Encode(ViewBag.modelList));
        console.log(modelList)
        $.each(modelList,function(indx,val){
            $("#fileId").append('<option value="'+val.Value+'">'+val.Name+'</option>')
        })
    })
</script>

@*<script src="https://code.jquery.com/jquery-3.5.1.min.js"
        integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
        crossorigin="anonymous"></script>*@
<script src="~/Content/scripts/jquery-3.5.1.min.js"></script>

<div class="card card-default">
    <div class="card-header">
        <h3 class="card-title">Info</h3>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>Header</label>
                    <input id="input_header" class="form-control" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>No. Of Fields</label>
                    <input class="form-control" type="number" id="input_fields" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Footer</label>
                    <input class="form-control" id="input_footer" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Select File</label>
                    <select class="form-control" id="fileId">
                        <option>Select File Name</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Result</h3>
        <div class="card-tools">
            <ul class="nav nav-pills ml-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="javascript:void(0);" onclick="saveSetting()">Save</a>
                </li>
            </ul>
        </div>
    </div>
    <!-- /.card-header -->
    <div class="card-body p-0">
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 10%">Sn.</th>
                    <th style="width: 70%">Parameters</th>
                    <th style="width: 20%"><center>Integer Value / Status</center>  </th>
                </tr>
            </thead>
            <tbody id="settingTr"></tbody>
        </table>
    </div>
    <!-- /.card-body -->
</div>

