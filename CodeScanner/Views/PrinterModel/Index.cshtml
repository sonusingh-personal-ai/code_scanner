@model Entity.enPrinterModel
@{
    var PrinterModelList = ViewBag.PrinterModelList as List<Entity.enPrinterModel> ?? new List<Entity.enPrinterModel>();
    var PrinterModelValueList = ViewBag.PrinterModelValueList as List<Entity.enPrinterModelValue> ?? new List<Entity.enPrinterModelValue>();

    // Detect if we are in Edit Mode for Model
    var isEditModel = Model != null && Model.Id > 0;

    // Detect if we are in Edit Mode for Value
    var selectedValue = ViewBag.SelectedPrinterModelValue as Entity.enPrinterModelValue;
    var isEditValue = selectedValue != null && selectedValue.Id > 0;

    var sn = 1;
    var snValue = 1;
}

<section class="content">
    <div class="container-fluid">
        <div class="row">

            <!-- Section 1: Printer Model -->
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">@(isEditModel ? "Edit Printer Model" : "Add Printer Model")</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <form action="@Url.Action(isEditModel ? "UpdatePrinterModel" : "CreatePrinterModel", "PrinterModel")" method="post">
                            @Html.AntiForgeryToken()

                            @* HIDDEN ID FIELD FOR UPDATE *@
                            @if (isEditModel)
                            {
                                @Html.HiddenFor(m => m.Id)
                            }

                            <div class="form-group">
                                <label for="Name">Printer Model Name</label>
                                @Html.TextBox("Name", isEditModel ? Model.Name : "", new { type = "text", required = "required", @class = "form-control", placeholder = "Enter Printer Model Name" })
                            </div>
                            <div class="card-footer">
                                <input type="submit" value="@(isEditModel ? "Update Printer Model" : "Add Printer Model")" class="btn btn-primary" />
                                @if (isEditModel)
                                {
                                    <a href="@Url.Action("Index", "PrinterModel")" class="btn btn-default float-right">Cancel</a>
                                }
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Printer Models</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <table id="printerModelsTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th style="width: 10px">#</th>
                                    <th>Name</th>
                                    <th style="width: 40px">Edit</th>
                                    <th style="width: 40px">Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in PrinterModelList)
                                {
                                    <tr>
                                        <td>@sn</td>
                                        <td>@item.Name</td>
                                        <td>
                                            <a href="@Url.Action("UpdatePrinterModel", "PrinterModel", new { id = item.Id })" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <a href="javascript:void(0);" onclick="deletePrinterModel(@item.Id, '@item.Name')" title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    sn++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Section 2: Printer Model Value -->
            <div class="col-md-6">
                <div class="card card-success">
                    <div class="card-header">
                        <h3 class="card-title">@(isEditValue ? "Edit Printer Model Value" : "Add Printer Model Value")</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <form action="@Url.Action(isEditValue ? "UpdatePrinterModelValue" : "CreatePrinterModelValue", "PrinterModel")" method="post">
                            @Html.AntiForgeryToken()

                            @* HIDDEN ID FIELD FOR UPDATE *@
                            @if (isEditValue)
                            {
                                <input type="hidden" name="Id" value="@selectedValue.Id" />
                            }

                            <div class="form-group">
                                <label for="ModelId">Printer Model</label>
                                <select name="ModelId" class="form-control" required="required">
                                    <option value="">Select Printer Model</option>
                                    @foreach (var pm in PrinterModelList)
                                    {
                                        var isSelected = isEditValue && selectedValue.ModelId == pm.Id;
                                        <option value="@pm.Id" selected="@(isSelected ? "selected" : null)">@pm.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="Name">Parameter Name</label>
                                <input type="text" name="Name" value="@(isEditValue ? selectedValue.Name : "")" required="required" class="form-control" placeholder="Enter Parameter Name (e.g., Print Speed, Resolution)" />
                            </div>
                            <div class="form-group">
                                <label for="Value">Parameter Value</label>
                                <input type="text" name="Value" value="@(isEditValue ? selectedValue.Value : "")" required="required" class="form-control" placeholder="Enter Parameter Value" />
                            </div>
                            <div class="card-footer">
                                <input type="submit" value="@(isEditValue ? "Update Printer Model Value" : "Add Printer Model Value")" class="btn btn-success" />
                                @if (isEditValue)
                                {
                                    <a href="@Url.Action("Index", "PrinterModel")" class="btn btn-default float-right">Cancel</a>
                                }
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Printer Model Values</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <table id="printerModelValuesTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th style="width: 10px">#</th>
                                    <th>Model</th>
                                    <th>Parameter</th>
                                    <th>Value</th>
                                    <th style="width: 40px">Edit</th>
                                    <th style="width: 40px">Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in PrinterModelValueList)
                                {
                                    var modelName = PrinterModelList.FirstOrDefault(m => m.Id == item.ModelId)?.Name ?? "Unknown";
                                    <tr>
                                        <td>@snValue</td>
                                        <td>@modelName</td>
                                        <td>@item.Name</td>
                                        <td>@item.Value</td>
                                        <td>
                                            <a href="@Url.Action("UpdatePrinterModelValue", "PrinterModel", new { id = item.Id })" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <a href="javascript:void(0);" onclick="deletePrinterModelValue(@item.Id, '@item.Name')" title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    snValue++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#printerModelsTable').DataTable({
                "paging": true,
                "pageLength": 5,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true
            });

            $('#printerModelValuesTable').DataTable({
                "paging": true,
                "pageLength": 5,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true
            });
        });

        function deletePrinterModel(id, name) {
            if (confirm("Are you sure you want to delete Printer Model '" + name + "'?")) {
                $.ajax({
                    url: '@Url.Action("DeletePrinterModel", "PrinterModel")',
                    type: 'POST',
                    data: { id: id },
                    success: function (result) {
                        if (result === "s") {
                            location.reload();
                        } else {
                            alert("Failed to delete Printer Model.");
                        }
                    }
                });
            }
        }

        function deletePrinterModelValue(id, name) {
            if (confirm("Are you sure you want to delete Printer Model Value '" + name + "'?")) {
                $.ajax({
                    url: '@Url.Action("DeletePrinterModelValue", "PrinterModel")',
                    type: 'POST',
                    data: { id: id },
                    success: function (result) {
                        if (result === "s") {
                            location.reload();
                        } else {
                            alert("Failed to delete Printer Model Value.");
                        }
                    }
                });
            }
        }
    </script>
}