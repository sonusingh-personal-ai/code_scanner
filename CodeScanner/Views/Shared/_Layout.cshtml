    <script type="text/javascript">

        $(function () {
            $("#export").click(function () {
                $("#export_table").tableToCSV();
            });
        });

        $("#input_fields").on('keyup', function () {
            var i = $("#input_fields").val();
            var blankArry = [];
            blankArry.length = i;
            $("#settingTr").empty();

            $.each(blankArry, function (i, v) {
                var tr = '<tr><td style="width:10%">' + (i + 1) + ' </td> <td style="width:50%"><input id="parm_' + (i + 1) + '" class="form-control" /></td> <td class="jsgrid-cell jsgrid-align-center" style="width: 100px;"> <center> <input type="checkbox" id="isStatus_' + (i + 1) + '"> </center></td></tr>';
                $("#settingTr").append(tr)
            })
        });
        function changeStatus() {
            var status = $('input.checkbox_check').is(':checked')
            if (status) {
                $(".status_tr").hide()
                $(".integer_tr").show()
            } else {
                $(".status_tr").show()
                $(".integer_tr").hide()
            }
        }

        $(document).ready(function () {
            $('#example thead tr').clone(true).appendTo('#example thead');
            $('#example thead tr:eq(1) th').each(function (i) {
                if (i == 3 ||  i == 9 || i == 10) {
                    var title = $(this).text();
                    $(this).html('<input style="width:60px" type="text" placeholder="Search ' + title + '" />');

                    $('input', this).on('keyup change', function () {
                        if (table.column(i).search() !== this.value) {
                            table
                                .column(i)
                                .search(this.value)
                                .draw();
                        }
                    });
                } else {
                    $(this).html('<input style="width:60px" type="text" disable="disable" />');
                }
            });

            var table = $('#example').DataTable({
                "columnDefs": [
                { "width": "10%", "targets": 2 }
                ],
                "autoWidth": false,
                orderCellsTop: true,
                fixedHeader: false,
                "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]]
            });
            
        });
        function collaps() {
            $('[data-widget="pushmenu"]').PushMenu('toggle')
        }
    </script>
