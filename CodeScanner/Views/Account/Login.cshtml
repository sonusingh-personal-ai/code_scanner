@model Entity.enAdmin
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="card">
    <div class="card-body login-card-body">
        <p class="login-box-msg">Sign in to start your session</p>

        @using (Html.BeginForm())
        {
            <div class="input-group mb-3">
                @Html.TextBoxFor(item => item.UserID, new { @class = "form-control", placeholder = "UserId", type = "text", autofocus = "", Required="required" })
                <div class="input-group-append">
                    <div class="input-group-text">
                        <span class="fas fa-envelope"></span>
                    </div>
                </div>
            </div>
            <div class="input-group mb-3">
                @Html.TextBoxFor(item => item.Password, new { @class = "form-control", placeholder = "Password", type = "password",Required = "required" })
                <div class="input-group-append">
                    <div class="input-group-text">
                        <span class="fas fa-lock"></span>
                    </div>
                </div>
            </div>
            if(ViewBag.Error != null)
            {
                <div>
                    <p style="color:red">Incorrect credentials</p>
                </div>
            }
            <div class="row">
                <div class="col-6">
                    <button type="submit" class="btn btn-success btn-block">Sign In</button>
                </div>
                <div class="col-6">
                    <a href="/home/index" class="btn btn-info btn-block">home</a>
                </div>
            </div>
        }
    </div>
    <!-- /.login-card-body -->
</div>

