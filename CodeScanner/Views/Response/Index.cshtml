@section styles {
    <style>
        /* Status button styles */
        .cls_green {
            background-color: #28a745 !important;
            border-color: #28a745 !important;
            color: #ffffff !important;
        }

        .cls_red {
            background-color: #dc3545 !important;
            border-color: #dc3545 !important;
            color: #ffffff !important;
        }

        /* Clean DataTables spacing & alignment */
        .dt-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
        }

        .dataTables_length label {
            margin-bottom: 0;
            font-weight: 500;
        }

        .dataTables_length select {
            display: inline-block;
            width: auto;
            margin: 0 5px;
        }

        .dataTables_paginate {
            margin: 0;
            text-align: right;
        }
    </style>
}

<section class="content">
    <div class="container-fluid pt-1">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-outline card-primary shadow-sm">

                    <!-- Card Header with Title, Status Message & Action Buttons -->
                    <div class="card-header d-flex justify-content-between align-items-center py-1">
                        <h3 class="card-title font-weight-bold mb-0">Response Table</h3>

                        <div class="ml-auto d-flex align-items-center">
                            <span id="statusMessage" class="mr-3 font-weight-bold" style="display: none; color: #d9534f;"></span>
                            <button id="btnDeleteAll" class="btn btn-danger btn-md mr-2" onclick="deleteAllResp()" title="Delete All">
                                <i class="fa fa-trash"></i>
                            </button>
                            <button id="btnExport" class="btn btn-primary btn-md" onclick="getSelectedResponse()" title="Export">
                                <i class="fa fa-download"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Date Filters Body -->
                    <div class="card-body bg-light border-bottom py-3">
                        <div class="form-row">
                            <div class="form-group col-md-2 col-sm-6 mb-0">
                                <label for="min" class="font-weight-bold">Start Date</label>
                                <input type="text" class="form-control" id="min" name="min" autocomplete="off" placeholder="DD/MM/YYYY">
                            </div>
                            <div class="form-group col-md-2 col-sm-6 mb-0">
                                <label for="max" class="font-weight-bold">End Date</label>
                                <input type="text" id="max" name="max" class="form-control" autocomplete="off" placeholder="DD/MM/YYYY">
                            </div>
                        </div>
                    </div>

                    <!-- DataTable Body -->
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" role="grid" id="responseTbl" style="width:100%">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Id</th>
                                        <th>Sno</th>
                                        <th>BarCode</th>
                                        <th>Model</th>
                                        <th>Sys. Rating</th>
                                        <th>Prod. Line</th>
                                        <th>Card Sr. No.</th>
                                        <th>T-Stage</th>
                                        <th>Visual By</th>
                                        <th>Tested By</th>
                                        <th>Proc. Engg</th>
                                        <th>Date | Time</th>
                                        <th width="10px" class="text-center">Show</th>
                                        <th width="10px" class="text-center">Del</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script>
        var table;
        var minDate, maxDate;

        $(document).ready(function () {
            // 1. Initialize DateTime Pickers
            if (typeof DateTime !== 'undefined') {
                minDate = new DateTime($('#min'), { format: 'DD/MM/YYYY' });
                maxDate = new DateTime($('#max'), { format: 'DD/MM/YYYY' });
            }

            // 2. Single DataTable Initialization
            table = $('#responseTbl').DataTable({
                "processing": true,
                "serverSide": true,
                "filter": true,
                // Added 'f' to the top toolbar row so the search box displays on the right
                "dom": '<"dt-toolbar"<"dt-length"l><"dt-search"f><"dt-paginate-top"p>>' +
                    't' +
                    '<"dt-toolbar"<"dt-info"i><"dt-paginate-bottom"p>>',
                "language": {
                    "search": "Search:",
                    "searchPlaceholder": "Type to filter..."
                },
                "ajax": {
                    "url": "/response/GetResponse",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (data) {
                        data.startDate = $('#min').val();
                        data.endDate = $('#max').val();

                        if (data.length > 6000) {
                            data.length = 6000;

                            if (typeof toastersetting === 'function') {
                                toastersetting("Record fetch capped at 6,000 max entries.", "Warning", "warning", "#f0ad4e");
                            } else {
                                alert("Record fetch capped at 6,000 max entries.");
                            }
                        }
                    }
                },
                "columnDefs": [
                    { "targets": 11, "className": "text-center" },
                    { "targets": 12, "className": "text-center" },
                    { "targets": 13, "className": "text-center" }
                ],
                "columns": [
                    { "data": "Id" },
                    { "data": "Sno" },
                    { "data": "BarCode" },
                    { "data": "Model" },
                    { "data": "SysRating" },
                    { "data": "ProdLine" },
                    { "data": "CardSerNo" },
                    { "data": "QcStatus" },
                    { "data": "VisualBy" },
                    { "data": "TestedBy" },
                    { "data": "ProcEng" },
                    { "data": "Date" },
                    {
                        "data": function (o) {
                            return "<a href='/response/getResponseSummary/" + o.Id + "' class='btn btn-sm btn-info cls_" + o.Status + "' title='View'><i class='fa fa-eye'></i></a>";
                        }
                    },
                    {
                        "data": function (o) {
                            return "<a href='javascript:void(0);' onclick='deleteResponse(" + o.Id + ")' class='btn btn-sm btn-danger' title='Delete'><i class='fa fa-trash'></i></a>";
                        }
                    }
                ],
                "lengthMenu": [[10, 25, 50, 100, 200, 300, 400, 500, 1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000], [10, 25, 50, 100, 200, 300, 400, 500, 1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000]],
                "drawCallback": function (settings) {
                    alertFunc();
                }
            });

            // 3. Trigger table redraw on date changes
            $('#min, #max').on('change', function () {
                table.draw();
            });

            // Run collapse function if defined globally
            if (typeof collaps === 'function') {
                collaps();
            }
        });

        // Background styling helpers
        function changeBackGroup() {
            setTimeout(alertFunc, 200);
        }

        function alertFunc() {
            $(".cls_green").css("background-color", "green").css("color", "#fff");
            $(".cls_red").css("background-color", "red").css("color", "#fff");
        }
    </script>

    <script src="~/Content/scripts/response.js"></script>
}