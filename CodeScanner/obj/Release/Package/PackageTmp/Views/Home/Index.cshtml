@{
    ViewBag.Title = "Index";
    var QrCode = "";
    var PrinterName = "";
}

<style>
    * {
        box-sizing: border-box;
    }

    .row {
        margin-left: -5px;
        margin-right: -5px;
    }

    .form-control {
        margin-bottom: 0rem !important;
    }

    label {
        display: inline;
    }

        label:not(.form-check-label):not(.custom-file-label) {
            font-weight: 300;
        }

    .form-group {
        margin-bottom: 0rem;
    }

    .content-header {
        padding: 1px .5rem;
    }

    .table td, .table th {
        padding: 0em !important;
        font-weight: 100;
    }

    td {
        text-align: center;
        vertical-align: middle;
    }

    th {
        text-align: center;
        vertical-align: middle;
    }

    .isValidate {
        border-color: red;
    }
</style>

<script src="~/Content/scripts/jquery-3.5.1.min.js"></script>
<script>
    $(document).ready(function(){
        $(".main-header").hide()
        var port = @Html.Raw(Json.Encode(ViewBag.gen));
        var printerList = @Html.Raw(Json.Encode(ViewBag.Printers));
        var visualByList = @Html.Raw(Json.Encode(ViewBag.VisualBy));
        var testedByList = @Html.Raw(Json.Encode(ViewBag.TestedBy));
        var processEngList = @Html.Raw(Json.Encode(ViewBag.ProcessEng));
        var progDisplayNo = @Html.Raw(Json.Encode(ViewBag.ProgramDisplayNumber));

        $("#com_port").empty();
        $.each(port,function(indx,val){
            $("#com_port").append("<option value='"+val.Key +"'>"+val.Value+"</option>")
        })

        $("#prnter").empty();
        $.each(printerList,function(indx,val){
            $("#prnter").append("<option value='"+val.Key +"'>"+val.Value+"</option>")
        })

        $("#visualBy").append("<option value=''>Select Visual By</option>")
        $("#testedBy").append("<option value=''>Select Tested By</option>")
        $("#processEngg").append("<option value=''>Select ProcEng.</option>")

        $.each(visualByList,function(indx,val){
            $("#visualBy").append("<option value='"+val.ID +"'>"+val.Name+"</option>")
        })
        $.each(testedByList,function(indx,val){
            $("#testedBy").append("<option value='"+val.ID +"'>"+val.Name+"</option>")
        })
        $.each(processEngList,function(indx,val){
            $("#processEngg").append("<option value='"+val.ID +"'>"+val.Name+"</option>")
        })
        $.each(progDisplayNo,function(indx,val){
            $("#display_pv").append("<option value='"+val.ID +"'>"+val.Name+"</option>")
        })

        if(port.length > 0){
            $("#info_status").val("Enable").css("background","green")
        }else{
            $("#info_status").val("Disable").css("background","red")
        }
        setInfo()

        $('#bCode').codeScanner({
            maxEntryTime: 500,
            onScan: function ($element, code) {
                $('#sysNumber').val('');
                $('#sysNumber').val(code);
                SendToComPort(false);
            }
        });

        getValueFromLocalStorage();
        $("#productionLine").on("change",function(i,e){
            checkProductionLine()
        })
        
        $('#productionLine').trigger("change");

        //$('#customSwitches').on("change",function(){
        //    var isDispProgNoOn = $('#customSwitches:checked').val();
        //    if(isDispProgNoOn == 'on'){
        //        $("#display_pv").attr("disabled","disabled").val('')

        //    }else{
        //        $("#display_pv").removeAttr("disabled");
        //    }
        //});

        //$("#display_pv").attr("disabled","disabled")
        //$('#customSwitches').prop('checked', true);
        collaps()
        setCustomSwtich()
        //autoGenerateExcel()
    })

    function checkProductionLine(){
        var ProdLine=$("#productionLine").val();
        if(ProdLine == '1'){
            $("#serialCardNo").attr("disabled","disabled").val('')
        }else if(ProdLine == '2'){
            $("#serialCardNo").removeAttr("disabled")
            $("#serialCardNo").val(localStorage.getItem("serialCardNo"))
        }
    }

    function PrintQr(){
        var qrCode = $("#sysNumber").val();
        var printer = $("#prnter").val();
        $.ajax({
            async: false,
            type: "GET",
            url: "/home/printqrcode?qrCode=" + qrCode + "&printerName=" + printer,
            success: function (resp) {
                alert("Print Done")
            },
            error: function (xhr, status) {
                console.log(xhr)
                console.log(status)
            }
        })
    }

    function validate(){
        $("QcStatus").val();
    }

    function autoGenerateExcel(){
        $.ajax({
            async: false,
            type: "GET",
            url: "/home/generateExcel",
            success: function (resp) {
                
            },
            error: function (xhr, status) {
                console.log(xhr)
                console.log(status)
            }
        })
    }

</script>

<div class="card card-default">
    <!-- /.card-header -->
    <div class="card-body" style="padding:5px">
        <div class="row">
            <div class="col-md-2">
                <div class="form-group">
                    <label>Date / Time</label>
                    <input style="width:49%" class="form-control" id="info_date" disabled="disabled" />
                    <input style="width:49%;float:right;margin-top:-38px" class="form-control" id="info_time" disabled="disabled" />
                </div>
                <div class="form-group">
                    <label>Display Prog. No.</label>
                    @*<input style="width:85%" class="form-control" id="display_pv"  maxlength="20"/>
                    <div style="width:20%;float:right;margin-top: -32px;margin-right: -40px;" class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="customSwitches">
                        <label class="custom-control-label" for="customSwitches"></label>
                    </div>*@
                    <select class="form-control" id="display_pv">
                        <option value="" selected> Select Display Pro. No.</option>
                    </select>

                </div>
                <div class="form-group">
                    <label>Status</label>
                    <input class="form-control" id="info_status" disabled="disabled" />
                </div>
            </div>

            <div class="col-md-2">
                <div class="form-group">
                    <label>Testing Stage</label>
                    <select class="form-control validate" id="QcStatus">
                        <option>Select QC Status</option>
                        <option value="1">Testing</option>
                        <option value="2">Qc</option>
                        <option value="3">Oqc</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Control Prog. No.</label>
                    <input class="form-control" id="control_pv" disabled="disabled" />
                </div>
                <div class="form-group">
                    <label>Model No</label>
                    <input class="form-control" id="bCode" readonly />
                </div>
            </div>

            <div class="col-md-2">
                <div class="form-group">
                    <label>Tested By</label>
                    <select class="form-control validate" id="testedBy"></select>
                </div>
                <div class="form-group">
                    <label>Visual By</label>
                    <select class="form-control validate" id="visualBy"></select>
                </div>
                <div class="form-group">
                    <label>Sys Rating</label>
                    <input class="form-control" id="sysRating" required="required" disabled="disabled"/>
                </div>
            </div>

            <div class="col-md-2">
                <div class="form-group">
                    <label>Production Line</label>
                    <select class="form-control validate" id="productionLine">
                        <option>Select Production Line</option>
                        <option value="1" selected>Card</option>
                        <option value="2">Assembly</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Process Engg.</label>
                    <select class="form-control validate" id="processEngg"></select>
                </div>
                <div class="form-group qrShow">
                    <label>Sys Sr. No.</label>
                    <input class="form-control" id="sysNumber" required="required" disabled="disabled" />
                </div>
                <div class="form-group qrHide" style="display:none">
                    <label>Sys Sr. No.</label>
                    <input class="form-control" id="sysNumberDup" />
                </div>
            </div>

            <div class="col-md-2">
                <div class="form-group">
                    <label>Card Serial Number</label>
                    <input class="form-control" id="serialCardNo" maxlength="20"/>
                </div>
                <div class="form-group">
                    <label>Printer List</label>
                    <select id="prnter" class="form-control">
                        <option>Select</option>
                    </select>
                </div>
                <div class="form-group qrShow">
                    <button class="btn btn-secondary  btn-sm" style="margin-top: 23px;height: 38px;width: -webkit-fill-available;" onclick="showInputField(1)"> Switch To Manual</button>
                </div>
                <div class="form-group qrHide" style="display:none">
                    <button class="btn btn-primary btn-sm" style="margin-top: 23px;height: 38px;width: -webkit-fill-available;" onclick="showInputField(2)"> Switch To Autometic</button>
                </div>
            </div>

            <div class="col-md-2">
                <div class="form-group">
                    <label>COM Port</label>
                    <select id="com_port" class="form-control validate">
                        <option>Select</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Baud Rate</label>
                    <select id="baudRate" class="form-control">
                        <option>Select</option>
                        <option value="110">110</option>
                        <option value="300">300</option>
                        <option value="600">600</option>
                        <option value="1200">1200</option>
                        <option value="2400">2400</option>
                        <option value="4800">4800</option>
                        <option value="9600">9600</option>
                        <option value="14400">14400</option>
                        <option value="19200">19200</option>
                        <option value="38400">38400</option>
                        <option value="57600">57600</option>
                        <option value="115200">115200</option>
                        <option value="128000">128000</option>
                        <option value="256000">256000 </option>
                    </select>
                </div>
                <div class="form-group">
                    <button class="btn btn-secondary btn-sm" style="margin-top: 23px;height: 38px;width: 100px;" onclick="PrintQr()">Print</button>
                    <button class="btn btn-primary btn-sm qrHide" style="margin-top: 23px;height: 38px;width: 100px; display:none" onclick="startTesting()">Start</button>

                </div>
                <div class="form-group">
                </div>
            </div>
            <!-- /.col -->
        </div>
    </div>
</div>

